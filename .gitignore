# Dependencies
# Unanchored so this also covers the nested example app.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
# `dist/` is regenerated by `npm run build`; the published package is built
# from it via prepublishOnly, so it never needs to be committed.
dist/
*.tsbuildinfo

# Next.js (examples/nextjs-demo)
# Unanchored so the nested .next/ is covered too.
.next/
out/
/build

# Test / coverage output
coverage/

# e2e verification writes a fresh screenshot on every run
examples/nextjs-demo/e2e/demo.png

# Agent tooling scratch worktrees (each is a nested git repo)
.kilo/worktrees/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment
# Note: no .env files are committed; add an exception here if you add one.
.env*
!.env.example

# Vercel
.vercel

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Editors
.idea/
*.swp

# Logs and caches from tools
.eslintcache
.cache/